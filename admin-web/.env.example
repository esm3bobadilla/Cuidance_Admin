# Cuidance Admin Web: build settings (Phase A2). Copy to .env.local (git-ignored) to use them.
#
# Leave everything unset for SAMPLE MODE (the default, D9). The GitHub Pages build never sets these.
#
# Supabase mode: real sign-in and review data from the "Cuidance Admin Web — Development"
# project (never the public app's project, D1). All three must be set.
#
# NEVER put the service-role / secret key, the database password or an access token here.
# These values are built into the browser code, so only the public key belongs here; the app
# refuses to start Supabase mode with a secret key.

# sample (default) or supabase
NEXT_PUBLIC_ADMIN_DATA_MODE=

# Project URL, e.g. https://<project-ref>.supabase.co (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=

# The project's public key: the publishable key ("sb_publishable_…") or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
