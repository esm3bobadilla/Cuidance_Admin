{
  // Phase 2 PR 2: compiles the shared workflow rules and their tests for Node's built-in
  // test runner (`npm test`). No test packages: TypeScript and Node only.
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": ".test-build",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["../shared/workflows/**/*.ts"]
}
